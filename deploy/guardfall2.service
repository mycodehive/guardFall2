[Unit]
Description=GuardFall2 Django web
After=network.target
[Service]
User=guardfall
Group=guardfall
WorkingDirectory=/srv/guardfall2
EnvironmentFile=/srv/guardfall2/.env
ExecStart=/srv/guardfall2/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 120
Restart=on-failure
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/guardfall2
[Install]
WantedBy=multi-user.target
